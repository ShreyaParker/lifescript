SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-backend-only-service-key
AI_PROVIDER=ollama
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:4b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
# Hosted alternative: AI_PROVIDER=gemini, plus an appropriate data-processing policy.
GEMINI_API_KEY=
GENERATION_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=gemini-embedding-2
# Required for multi-worker deployments; empty uses a single-worker local SQLite checkpoint.
CHECKPOINT_DATABASE_URL=
DATA_DIR=.local
ENABLE_AUDIO=false
WHISPER_MODEL=base
ENABLE_DOCLING=false
# Optional separately authorized calendar integration. Generate the Fernet key locally.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URL=http://127.0.0.1:8000/v1/calendar/callback
TOKEN_ENCRYPTION_KEY=
CORS_ORIGINS=["http://localhost:8080","http://127.0.0.1:8080"]
