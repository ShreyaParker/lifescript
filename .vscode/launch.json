{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "LifeScript web",
      "type": "dart",
      "request": "launch",
      "cwd": "${workspaceFolder}/frontend",
      "program": "lib/main.dart",
      "deviceId": "chrome",
      "toolArgs": [
        "--web-port",
        "8080"
      ],
      "preLaunchTask": "Start backend services"
    }
  ]
}
